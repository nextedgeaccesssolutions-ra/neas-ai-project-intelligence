# NEAS AI Project Intelligence — environment template. Copy to .env.local (never commit real values).
# Leave the Supabase values empty to run in DEVICE MODE (no accounts, data stays on each device).

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# hours a signed-in user may keep working offline before signing in again
NEXT_PUBLIC_OFFLINE_GRACE_HOURS=72

# --- Server only (Vercel → Settings → Environment Variables; never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters; keys the hashing of client IP addresses for passcode throttling
CLIENT_PORTAL_SECRET=
# public base URL used in e-mail links, e.g. https://neas-project-control.vercel.app
APP_URL=
APP_TIMEZONE=Asia/Manila

# Google Sheets bridge (integrations/apps-script-cloud.gs)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
